# Copy this file to .env and fill it in. .env is ignored by git; this example is safe to commit.

# From TiDB's Connect dialog
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=

# Signs the sign-in cookie. Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Anyone creating a profile must type this. Share it only with the household.
HOUSE_INVITE_CODE=

# false for http://bohol-house:5000, true for https (Vercel or `tailscale serve`)
COOKIE_SECURE=false

DISCORD_WEBHOOK_URL=
